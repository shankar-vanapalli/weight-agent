# ── Required ──────────────────────────────────────────────────
# Get your free API key from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── LLM ───────────────────────────────────────────────────────
# Available models: https://openrouter.ai/models
LLM_MODEL=google/gemini-2.5-flash

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# WORKERS: ignored in dev (always 1). In prod, set to CPU count.
WORKERS=2
# ENV: "development" enables hot-reload (1 worker).
#      "production" disables reload, uses WORKERS value.
ENV=development
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────
# Comma-separated allowed origins.
#
# DEV:  Frontend is served from the backend at http://localhost:8000/app
#       so CORS is same-origin and this setting is not critical.
#
# PROD: Set this to your actual domain(s), e.g.:
#       ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
#
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=30

# ── RAG & Search ──────────────────────────────────────────────
DEFAULT_SEARCH_RESULTS=5
MAX_SEARCH_RESULTS=10
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_RESULTS=5

# ══════════════════════════════════════════════════════════════
# PRODUCTION CHECKLIST
# ══════════════════════════════════════════════════════════════
# 1. Set ENV=production
# 2. Set WORKERS to your CPU count (e.g. 4)
# 3. Set ALLOWED_ORIGINS to your real domain(s) only
# 4. Set LOG_LEVEL=WARNING to reduce noise
# 5. Set RATE_LIMIT_PER_MINUTE appropriate to traffic
# 6. Run behind a reverse proxy (nginx/caddy) with HTTPS
# 7. Never commit .env to git (it's in .gitignore)
